{
  "name": "redlined1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "backfill:repair-graph": "tsx scripts/backfill-repair-cases-to-graph.ts",
    "intelligence:recalculate": "tsx scripts/recalculate-shop-intelligence.ts",
    "memory:rebuild": "tsx scripts/rebuild-business-memory.ts",
    "intelligence:vehicles": "tsx scripts/rebuild-vehicle-intelligence.ts",
    "intelligence:learning": "tsx scripts/recalculate-intelligence-learning.ts",
    "intelligence:service-advisor": "tsx scripts/analyze-service-advisor-opportunities.ts",
    "intelligence:customers": "tsx scripts/rebuild-customer-lifetime-intelligence.ts",
    "sapelee:flush": "tsx scripts/flush-sapelee-outbox.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=smoke-chromium",
    "test:visual": "playwright test --project=visual",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ci": "playwright test --reporter=list,junit,html",
    "test:local": "cross-env TEST_MODE=local PLAYWRIGHT_BASE_URL=http://localhost:3000 TEST_BASE_URL=http://localhost:3000 playwright test --project=local",
    "test:local:headed": "cross-env TEST_MODE=local PLAYWRIGHT_BASE_URL=http://localhost:3000 TEST_BASE_URL=http://localhost:3000 playwright test --project=local --headed",
    "test:local:ui": "cross-env TEST_MODE=local PLAYWRIGHT_BASE_URL=http://localhost:3000 TEST_BASE_URL=http://localhost:3000 playwright test --project=local --ui",
    "test:smoke:prod": "cross-env TEST_MODE=production playwright test --project=smoke-chromium",
    "test:audit": "cross-env TEST_MODE=production ALLOW_PROD_E2E=true playwright test --project=audit",
    "test:unit": "jest",
    "test:report": "playwright show-report tests/reports/html",
    "test:sweep": "npx tsx scripts/sweep-e2e-data.ts"
  },
  "dependencies": {
