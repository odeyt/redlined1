# ─────────────────────────────────────────────────────────────
# Redlined1 — LOCAL DEVELOPMENT environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────

# ─── App Environment ───────────────────────────────────────────────────────────
# MUST be "development" for local — controls env banner + feature flag behavior
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FEATURE_FLAGS_ENV=development

# ─── Supabase ─────────────────────────────────────────────────────────────────
# USE YOUR DEV PROJECT — never use production keys locally
# Get from: supabase.com → redlined1-dev → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_DEV_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY   # ⚠️ never expose to browser

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Leave blank to use MOCK MODE (recommended for most local development)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=anthropic          # "anthropic" | "mock"
AI_MODEL=claude-haiku-4-5-20251001

# ─── Email ────────────────────────────────────────────────────────────────────
# Resend API key — dev key or leave blank to skip email sending
# Get from: resend.com → API Keys
RESEND_API_KEY=re_YOUR_DEV_KEY

# ─── SMS (future) ─────────────────────────────────────────────────────────────
# Leave blank to disable SMS in development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payments — Creem.io ──────────────────────────────────────────────────────
# Use Creem TEST mode in development
PAYMENT_PROVIDER=creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_SUCCESS_URL=http://localhost:3000/dashboard?success=1
CREEM_CANCEL_URL=http://localhost:3000/dashboard?canceled=1
CREEM_STARTER_MONTHLY_PRODUCT_ID=
CREEM_STARTER_ANNUAL_PRODUCT_ID=
CREEM_PROFESSIONAL_MONTHLY_PRODUCT_ID=
CREEM_PROFESSIONAL_ANNUAL_PRODUCT_ID=
CREEM_SHOP_PRO_MONTHLY_PRODUCT_ID=
CREEM_SHOP_PRO_ANNUAL_PRODUCT_ID=
CREEM_ENTERPRISE_MONTHLY_PRODUCT_ID=
CREEM_ENTERPRISE_ANNUAL_PRODUCT_ID=

# ─── Payments — Stripe (future) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Analytics / Monitoring ───────────────────────────────────────────────────
# Leave blank — do not send dev traffic to GA or Sentry
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── AI Limits ────────────────────────────────────────────────────────────────
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PRO=200
AI_DAILY_LIMIT_PRO_PLUS=1000
