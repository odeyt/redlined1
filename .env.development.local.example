# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV → STAGING DATABASE
#
# Copy to `.env.development.local` and fill in your redlined1-staging values.
# That filename is gitignored and, per Next.js precedence, overrides .env.local
# for `next dev` only:
#
#   .env.development.local  >  .env.local  >  .env.development  >  .env
#
# So your production values in .env.local stay intact for builds and scripts.
# Delete this file to point local dev back at production. Nothing else changes.
#
# Get the values from: supabase.com → redlined1-staging → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=staging

# Staging project URL — must NOT be the production ref (ldjrlvjkmzrcdqhetqoh).
# The E2E harness refuses to create test data if it sees the production ref.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY

# The staging ref on its own. The E2E harness warns when the database it is
# about to seed is neither production nor this — which catches a half-applied
# env change, where the file was updated but the shell still holds the old URL.
STAGING_PROJECT_REF=YOUR_STAGING_REF

# Needed by the E2E harness to provision and tear down throwaway tenants.
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY

# Keep billing off locally so no checkout can ever be triggered against a
# real payment provider from a dev machine.
NEXT_PUBLIC_BILLING_ENABLED=false
