# ─────────────────────────────────────────────────────────────
# Redlined1 — PRODUCTION environment variables
# Set these in Vercel → redlined1 project → Settings → Environment Variables
# Scope: "Production" only
# NEVER commit real values — this file is a reference only
# ─────────────────────────────────────────────────────────────

# ─── App Environment ───────────────────────────────────────────────────────────
# MUST be "production" — disables env banner, enforces strict feature flag defaults
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://redlined1.com
NEXT_PUBLIC_FEATURE_FLAGS_ENV=production

# ─── Supabase ─────────────────────────────────────────────────────────────────
# ⚠️  PRODUCTION credentials — guard carefully
# Get from: supabase.com → redlined1-prod → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PROD_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_KEY   # ⚠️ never expose to browser

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_PROD_KEY

# ─── SMS (future) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payments — Creem.io ──────────────────────────────────────────────────────
# ⚠️  LIVE mode credentials — real charges will occur
PAYMENT_PROVIDER=creem
CREEM_API_KEY=YOUR_CREEM_LIVE_API_KEY
CREEM_WEBHOOK_SECRET=YOUR_CREEM_PROD_WEBHOOK_SECRET
CREEM_SUCCESS_URL=https://redlined1.com/dashboard?success=1
CREEM_CANCEL_URL=https://redlined1.com/dashboard?canceled=1
CREEM_STARTER_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_STARTER_ANNUAL_PRODUCT_ID=prod_xxx
CREEM_PROFESSIONAL_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_PROFESSIONAL_ANNUAL_PRODUCT_ID=prod_xxx
CREEM_SHOP_PRO_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_SHOP_PRO_ANNUAL_PRODUCT_ID=prod_xxx
CREEM_ENTERPRISE_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_ENTERPRISE_ANNUAL_PRODUCT_ID=prod_xxx

# ─── Payments — Stripe (future) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_PROD_SECRET

# ─── Analytics / Monitoring ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-9QY4K8MZ1X

# Sentry — required in production for error alerting
# Get DSN from: sentry.io → your project → Settings → Client Keys (DSN)
SENTRY_DSN=YOUR_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ORG=YOUR_SENTRY_ORG
SENTRY_PROJECT=redlined1
SENTRY_AUTH_TOKEN=YOUR_SENTRY_CI_AUTH_TOKEN  # for source map uploads in CI
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_ENABLE_OBSERVABILITY=true
OBSERVABILITY_PROVIDER=sentry
LOG_LEVEL=warn

# ─── AI Limits ────────────────────────────────────────────────────────────────
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PRO=200
AI_DAILY_LIMIT_PRO_PLUS=1000

# ─── Commercial Billing Platform ──────────────────────────────────────────────
BILLING_PROVIDER=creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_STARTER_MONTHLY_PRODUCT_ID=
CREEM_STARTER_ANNUAL_PRODUCT_ID=
CREEM_PROFESSIONAL_MONTHLY_PRODUCT_ID=
CREEM_PROFESSIONAL_ANNUAL_PRODUCT_ID=
CREEM_BUSINESS_MONTHLY_PRODUCT_ID=
CREEM_BUSINESS_ANNUAL_PRODUCT_ID=
# Sandbox vs live. When true the provider talks to Creem test host and NO real
# money moves. Requires a TEST api key (creem_test_...) and TEST product ids
# from Creem test dashboard — live credentials are rejected by the sandbox.
# Check /api/billing/env-check (platform owner only): testModeMatchesKey must
# be true, or checkout fails with an opaque 401.
CREEM_TEST_MODE=false

# Optional override if Creem changes the API host.
# CREEM_BASE_URL=

# Turns on checkout and the upgrade path. Requires CREEM_WEBHOOK_SECRET to be
# set as well — the webhook endpoint rejects every event without it, so paid
# subscriptions would never activate.
NEXT_PUBLIC_BILLING_ENABLED=false

# Whether a LAPSED plan hard-locks the app behind "subscription required".
# Independent of billing on purpose: accepting payments and locking people out
# are separate decisions.
#
# Leave false to match the "Free forever with core features" promise on the
# signup page — a lapsed trial drops to the free tier and keeps working. This
# also means a fault in the payment path cannot leave a customer both locked
# out and unable to pay.
#
# Set true only for a deliberate trial-then-pay model, and update the signup
# copy to match.
NEXT_PUBLIC_ENFORCE_PLAN_LOCK=false
