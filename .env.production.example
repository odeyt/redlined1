# ─────────────────────────────────────────────────────────────
# Redlined1 — PRODUCTION environment variables
# Set these in Vercel → redlined1 project → Settings → Environment Variables
# Scope: "Production" only
# NEVER commit real values — this file is a reference only
# ─────────────────────────────────────────────────────────────

# ─── App Environment ───────────────────────────────────────────────────────────
# MUST be "production" — disables env banner, enforces strict feature flag defaults
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=https://redlined1.com
NEXT_PUBLIC_FEATURE_FLAGS_ENV=production

# ─── Supabase ─────────────────────────────────────────────────────────────────
# ⚠️  PRODUCTION credentials — guard carefully
# Get from: supabase.com → redlined1-prod → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PROD_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_KEY   # ⚠️ never expose to browser

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001

# ─── Email ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_PROD_KEY

# ─── SMS (future) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payments — Creem.io ──────────────────────────────────────────────────────
# ⚠️  LIVE mode credentials — real charges will occur
PAYMENT_PROVIDER=creem
CREEM_API_KEY=YOUR_CREEM_LIVE_API_KEY
CREEM_WEBHOOK_SECRET=YOUR_CREEM_PROD_WEBHOOK_SECRET
CREEM_SUCCESS_URL=https://redlined1.com/dashboard?success=1
CREEM_CANCEL_URL=https://redlined1.com/dashboard?canceled=1
CREEM_STARTER_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_STARTER_ANNUAL_PRODUCT_ID=prod_xxx
CREEM_PROFESSIONAL_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_PROFESSIONAL_ANNUAL_PRODUCT_ID=prod_xxx
CREEM_SHOP_PRO_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_SHOP_PRO_ANNUAL_PRODUCT_ID=prod_xxx
CREEM_ENTERPRISE_MONTHLY_PRODUCT_ID=prod_xxx
CREEM_ENTERPRISE_ANNUAL_PRODUCT_ID=prod_xxx

# ─── Payments — Stripe (future) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_PROD_SECRET

# ─── Analytics / Monitoring ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-9QY4K8MZ1X
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=production

# ─── AI Limits ────────────────────────────────────────────────────────────────
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PRO=200
AI_DAILY_LIMIT_PRO_PLUS=1000
