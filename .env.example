# ─────────────────────────────────────────────────────────────
# Redlined1 CRM  —  Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (safe to expose — public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (safe to expose — RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# Supabase service-role key (⚠️  NEVER expose to browser)
# Used only by Server Components (customer portal) and Route Handlers.
# Get this from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# Resend API key — used by /api/chat to email chat messages to admin@redlined1.com
# Get a free key at: https://resend.com → API Keys
RESEND_API_KEY=re_YOUR_KEY_HERE

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Anthropic Claude API key — used by /api/ai for DTC explanations, estimate drafts,
# customer messages, invoice summaries, and repair case analysis.
# Get a key at: https://console.anthropic.com → API Keys
# Leave blank to run in MOCK MODE (returns example responses, no real AI calls).
ANTHROPIC_API_KEY=

# OpenAI key — reserved for future fallback provider (not yet used)
OPENAI_API_KEY=

# AI provider: "anthropic" (default) | "mock" (forces mock mode even with a key)
AI_PROVIDER=anthropic

# ─── Intelligence Provider (SI-8) ─────────────────────────────────────────────
# Active intelligence provider: "mock" (default) | "sapelee"
# "mock" mode is always safe — no external calls, no AI, no PII exposure.
INTELLIGENCE_PROVIDER=mock

# Sapelee API credentials — only needed when INTELLIGENCE_PROVIDER=sapelee
# Leave blank to run in mock mode (safe default).
SAPELEE_API_URL=
SAPELEE_API_KEY=
SAPELEE_COMPANY_ID=

# Set to "true" to show Sapelee UI elements (badges, insight panels).
# Safe to leave false even when Sapelee is connected server-side.
NEXT_PUBLIC_SAPELEE_ENABLED=false

# Claude model to use. Defaults to claude-haiku-4-5-20251001 (fast + affordable).
# Options: claude-haiku-4-5-20251001 | claude-sonnet-5 | claude-opus-4-8
AI_MODEL=claude-haiku-4-5-20251001

# Daily AI request limits per shop (not yet enforced — placeholder for billing)
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PRO=200
AI_DAILY_LIMIT_PRO_PLUS=1000

# ─── Payment Provider ──────────────────────────────────────────────────────────
# Active payment provider: "creem" (default) | "stripe" (not yet implemented)
PAYMENT_PROVIDER=creem

# ─── Creem.io ─────────────────────────────────────────────────────────────────
# Get these from: https://creem.io → Dashboard → API Keys
CREEM_API_KEY=

# Webhook signing secret — from Creem dashboard → Webhooks → your endpoint
CREEM_WEBHOOK_SECRET=

# Redirect URLs after checkout
CREEM_SUCCESS_URL=https://YOUR_APP_URL/dashboard/billing?success=1
CREEM_CANCEL_URL=https://YOUR_APP_URL/dashboard/billing?canceled=1

# Creem product IDs — copy from Creem dashboard → Products for each plan/interval
# 4 paid plans × 2 billing intervals = 8 required IDs (enterprise = contact-sales, no ID needed)
CREEM_SOLO_MONTHLY_PRODUCT_ID=
CREEM_SOLO_ANNUAL_PRODUCT_ID=
CREEM_STARTER_MONTHLY_PRODUCT_ID=
CREEM_STARTER_ANNUAL_PRODUCT_ID=
CREEM_PROFESSIONAL_MONTHLY_PRODUCT_ID=
CREEM_PROFESSIONAL_ANNUAL_PRODUCT_ID=
CREEM_BUSINESS_MONTHLY_PRODUCT_ID=
CREEM_BUSINESS_ANNUAL_PRODUCT_ID=

# ─── Stripe (future — not yet active) ────────────────────────────────────────
# Activate by setting PAYMENT_PROVIDER=stripe and implementing stripe-provider.ts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PROFESSIONAL_ANNUAL_PRICE_ID=
STRIPE_SHOP_PRO_MONTHLY_PRICE_ID=
STRIPE_SHOP_PRO_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
