# ─────────────────────────────────────────────────────────────
# Redlined1 — STAGING environment variables
# Set these in Vercel → redlined1-staging project → Settings → Environment Variables
# Scope: "Preview" or create a separate staging project
# NEVER commit real values — this file is a reference only
# ─────────────────────────────────────────────────────────────

# ─── App Environment ───────────────────────────────────────────────────────────
# MUST be "staging" — controls env banner + feature flag behavior
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.redlined1.com    # ← change to your staging domain
NEXT_PUBLIC_FEATURE_FLAGS_ENV=staging

# ─── Supabase ─────────────────────────────────────────────────────────────────
# ⚠️  MUST be staging project credentials — NOT production
# Get from: supabase.com → redlined1-staging → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY   # ⚠️ never expose to browser

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Can share the same Anthropic key as production (usage is low on staging)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
OPENAI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5-20251001

# ─── Email ────────────────────────────────────────────────────────────────────
# Use a separate Resend API key for staging, or the same key with a test domain
RESEND_API_KEY=re_YOUR_STAGING_KEY

# ─── SMS (future) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payments — Creem.io ──────────────────────────────────────────────────────
# ⚠️  Use Creem TEST mode / test product IDs for staging
# Register a separate webhook: https://staging.redlined1.com/api/webhooks/creem
PAYMENT_PROVIDER=creem
CREEM_API_KEY=YOUR_CREEM_TEST_API_KEY
CREEM_WEBHOOK_SECRET=YOUR_CREEM_STAGING_WEBHOOK_SECRET
CREEM_SUCCESS_URL=https://staging.redlined1.com/dashboard?success=1
CREEM_CANCEL_URL=https://staging.redlined1.com/dashboard?canceled=1
CREEM_STARTER_MONTHLY_PRODUCT_ID=test_prod_xxx
CREEM_STARTER_ANNUAL_PRODUCT_ID=test_prod_xxx
CREEM_PROFESSIONAL_MONTHLY_PRODUCT_ID=test_prod_xxx
CREEM_PROFESSIONAL_ANNUAL_PRODUCT_ID=test_prod_xxx
CREEM_SHOP_PRO_MONTHLY_PRODUCT_ID=test_prod_xxx
CREEM_SHOP_PRO_ANNUAL_PRODUCT_ID=test_prod_xxx
CREEM_ENTERPRISE_MONTHLY_PRODUCT_ID=test_prod_xxx
CREEM_ENTERPRISE_ANNUAL_PRODUCT_ID=test_prod_xxx

# ─── Payments — Stripe (future) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_STAGING_SECRET

# ─── Analytics / Monitoring ───────────────────────────────────────────────────
# Do NOT send staging traffic to production GA property
NEXT_PUBLIC_GA_ID=               # leave blank or use a separate GA property

# Sentry — use same project as production but tag environment=staging
SENTRY_DSN=YOUR_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ORG=YOUR_SENTRY_ORG
SENTRY_PROJECT=redlined1
SENTRY_AUTH_TOKEN=YOUR_SENTRY_CI_AUTH_TOKEN
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_ENABLE_OBSERVABILITY=true
OBSERVABILITY_PROVIDER=sentry
LOG_LEVEL=info

# ─── AI Limits ────────────────────────────────────────────────────────────────
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PRO=200
AI_DAILY_LIMIT_PRO_PLUS=1000

# ─── Commercial Billing Platform ──────────────────────────────────────────────
BILLING_PROVIDER=creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_STARTER_MONTHLY_PRODUCT_ID=
CREEM_STARTER_ANNUAL_PRODUCT_ID=
CREEM_PROFESSIONAL_MONTHLY_PRODUCT_ID=
CREEM_PROFESSIONAL_ANNUAL_PRODUCT_ID=
CREEM_BUSINESS_MONTHLY_PRODUCT_ID=
CREEM_BUSINESS_ANNUAL_PRODUCT_ID=
NEXT_PUBLIC_BILLING_ENABLED=false
